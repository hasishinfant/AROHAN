# AROHAN — Environment Configuration Example

# ── Database Connection ────────────────────────────────────────────────────────
# Local default:
DATABASE_URL=sqlite+aiosqlite:///./arohan.db

# Vercel Deployment:
# 1) Zero-Config SQLite (Default on Vercel):
#    If DATABASE_URL is not set on Vercel, AROHAN automatically stores its SQLite
#    database in `/tmp/arohan.db` (the only writable directory in serverless functions).
#
# 2) Managed PostgreSQL (Vercel Postgres / Neon / Supabase / Railway):
#    Set DATABASE_URL in your Vercel Project Environment Variables:
#    DATABASE_URL=postgresql+asyncpg://user:password@host/dbname
#    (Standard postgres:// connection strings are automatically normalized to asyncpg).

# ── API Security Secret ───────────────────────────────────────────────────────
SECRET_KEY=arohan-sih-2026-proactive-logistics-secret

# ── Real-Time Streaming / WebSocket (Optional on Vercel) ──────────────────────
# On Vercel serverless, real-time sync automatically uses high-frequency HTTP polling.
# If you have an external WebSocket instance or proxy, configure it here:
# VITE_WS_URL=wss://your-websocket-server.com/ws

# ── External Integration Services (Optional / Prototyping) ─────────────────────
# Weather Provider API (OpenWeather / IMD)
WEATHER_API_KEY=
WEATHER_API_URL=https://api.openweathermap.org/data/2.5/forecast

# OpenStreetMap / OSRM Routing Service
ROUTING_API_URL=https://router.project-osrm.org/route/v1/driving

# Road Incident & Hazard Feeds
INCIDENT_API_URL=
HAZARDS_API_URL=

# ── Operational Thresholds (Configurable) ─────────────────────────────────────
DISRUPTION_PROB_THRESHOLD=0.60
HORIZON_HOURS_THRESHOLD=24
MISSION_SCORE_DELTA_THRESHOLD=20.0
